{
  "name": "mathcards",
  "version": "1.0.0",
  "description": "Локальные карточки для изучения математического анализа",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && node scripts/start-dev.mjs\"",
    "dev:ui": "vite",
    "build:electron": "node scripts/build-electron.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "start": "electron .",
    "test:e2e": "npm run build && node scripts/e2e.mjs",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64",
    "pack:mac": "npm run build && electron-builder --mac --dir",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "MathCards contributors",
  "license": "MIT",
  "dependencies": {
    "@tiptap/extension-image": "3.34.0",
    "@tiptap/extension-mathematics": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/react": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "adm-zip": "0.6.1",
    "katex": "0.18.10",
    "lucide-react": "1.73.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/adm-zip": "0.5.8",
    "@types/katex": "0.16.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "wait-on": "9.5.1"
  },
  "type": "module",
  "build": {
    "appId": "org.mathcards.desktop",
    "productName": "MathCards",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MathCards-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "MathCards-Setup-${version}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "installerLanguages": [
        "ru_RU"
      ],
      "language": "1049"
    },
    "portable": {
      "artifactName": "MathCards-Portable-${version}.exe"
    },
    "mac": {
      "category": "public.app-category.education",
      "target": "dir"
    }
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
